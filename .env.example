# Copier ce fichier en ".env" (jamais commité) puis remplir les valeurs.

# --- IA ---
# Fournisseur : groq (par défaut) ou gemini. Sans clé, le service IA passe en mode "mock" (questions de démo).
LLM_PROVIDER=groq
LLM_API_KEY=
# Laisser vide pour le modèle par défaut du fournisseur (voir ai-service/app/config.py)
LLM_MODEL=

# --- Sécurité ---
# Au moins 32 caractères aléatoires en dehors du développement.
JWT_SECRET=dev-secret-change-me-dev-secret-change-me-0123456789

# --- QR code ---
# Adresse que les téléphones des étudiants peuvent ouvrir (IP du PC sur le Wi-Fi), ex. http://192.168.1.20:3000
PUBLIC_URL=
