# Copier ce fichier en ".env" (jamais commité) puis remplir les valeurs.

# --- IA ---
# Fournisseur : groq (par défaut) ou gemini. Sans clé, le service IA passe en mode "mock" (questions de démo).
LLM_PROVIDER=groq
LLM_API_KEY=
# Laisser vide pour le modèle par défaut du fournisseur (voir ai-service/app/config.py)
LLM_MODEL=

# --- Sécurité ---
# Au moins 32 caractères aléatoires en dehors du développement.
JWT_SECRET=dev-secret-change-me-dev-secret-change-me-0123456789

# --- QR code ---
# Adresse que les téléphones des étudiants peuvent ouvrir (IP du PC sur le Wi-Fi), ex. http://192.168.1.20:3000
PUBLIC_URL=

# --- Confirmation email ---
# log  : aucun email envoyé, le code s'affiche dans les logs du backend (par défaut avec Docker en local)
#        -> commande : docker compose logs backend | findstr "MODE DEV"
# smtp : envoi réel ; les variables ci-dessous deviennent obligatoires.
APP_MAIL_MODE=log
# Clé aléatoire de 32 octets minimum encodée en Base64, distincte de JWT_SECRET.
APP_EMAILVERIFICATION_HMACKEY=
# Adresse d'expédition autorisée par votre fournisseur SMTP.
APP_EMAILVERIFICATION_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
